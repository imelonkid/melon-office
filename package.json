{
  "name": "melon-office",
  "version": "0.1.0",
  "description": "把你的 Claude Code 会话变成一层大厂工区：每个 AI 是一个员工，干活、举手要审批、去茶水间摸鱼。",
  "keywords": [
    "claude-code",
    "ai-agents",
    "visualization",
    "phaser",
    "isometric",
    "hooks"
  ],
  "homepage": "https://github.com/imelonkid/melon-office#readme",
  "bugs": {
    "url": "https://github.com/imelonkid/melon-office/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imelonkid/melon-office.git"
  },
  "license": "MIT",
  "author": "melonkid",
  "type": "module",
  "bin": {
    "melon-office": "bin/melon-office.mjs"
  },
  "files": [
    "bin",
    "server",
    "dist",
    "install.sh",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node bin/melon-office.mjs start --no-open & vite",
    "dev:demo": "node bin/melon-office.mjs demo --no-open & vite",
    "build": "vite build",
    "start": "node bin/melon-office.mjs start",
    "demo": "node bin/melon-office.mjs demo",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "assets": "node tools/build_illustrated_layout.mjs",
    "setup": "npm install && npm run build && node bin/melon-office.mjs init && node bin/melon-office.mjs start",
    "mac": "bash mac/build.sh"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "phaser": "^3.88.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
